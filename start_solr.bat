@echo off
chcp 65001 >nul
:: 切換到 bat 檔所在的目錄，確保相對路徑 ..\ 絕對正確
cd /d "%~dp0"

echo =========================================
echo           正在啟動 Solr 伺服器 ...
echo =========================================
:: 使用 call 來呼叫另一個 bat 檔，這樣執行完才不會直接閃退
call Solr\bin\solr.cmd start
echo.
echo =========================================
echo 啟動指令已送出，請開啟瀏覽器進入 http://localhost:8983
echo =========================================
pause