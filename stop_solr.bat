@echo off
chcp 65001 >nul
:: 切換到 bat 檔所在的目錄
cd /d "%~dp0"

echo =========================================
echo           正在關閉 Solr 伺服器 ...
echo =========================================

:: 關閉背景所有正在執行的 Solr 
call Solr\bin\solr.cmd stop -all
echo.
echo =========================================
echo Solr 已成功關閉！
echo =========================================
pause